s":[],"venue":{"id":"venue-e43d0ed7069ca7","name":"Multimedia Tools and Applications","short_name":"MTAP","type":"journal","issn":"1573-7721","rankings":[]},"task_tags":["image_forgery"],"contribution_type":"survey","review_status":"verified","doi":"10.1007/s11042-026-21588-w","arxiv_id":"","openalex_id":"","semantic_scholar_id":"","primary_url":"https://doi.org/10.1007/s11042-026-21588-w","citation_count":0,"provenance":[{"source":"crossref","source_id":"10.1007/s11042-026-21588-w","url":"https://doi.org/10.1007/s11042-026-21588-w","query":"image forgery localization @ ACM Multimedia","retrieved_at":"2026-07-16T07:42:49Z"}],"notes":"快速批量核验：具有稳定来源，且任务标签与图像取证范围一致。"},{"id":"paper-5e8e849c591e0293","title":"Securing copyright protection for retinal images through watermark image encryption in a robust zero-watermarking system","title_zh":"","year":2026,"publication_date":"","abstract":"","authors":[{"id":"author-3b36ab6b2f17bc","name":"Pavani Meesala","orcid":"0009-0002-0565-3521","institution_ids":[]},{"id":"author-71024c6fa0392a","name":"Dalton Meitei Thounaojam","orcid":"","institution_ids":[]}],"institution_ids":[],"venue":{"id":"venue-d964bb871a0375","name":"Biomedical Signal Processing and Control","short_name":"","type":"journal","issn":"1746-8094","rankings":[]},"task_tags":["digital_watermarking"],"contribution_type":"method","review_status":"verified","doi":"10.1016/j.bspc.2025.108237","arxiv_id":"","openalex_id":"","semantic_scholar_id":"","primary_url":"https://doi.org/10.1016/j.bspc.2025.108237","citation_count":1,"provenance":[{"source":"crossref","source_id":"10.1016/j.bspc.2025.108237","url":"https://doi.org/10.1016/j.bspc.2025.108237","query":"zero watermark image authentication","retrieved_at":"2026-07-16T04:06:17Z"}],"notes":"快速批量核验：具有稳定来源，且任务标签与图像取证范围一致。"},{"id":"paper-6d27c8b2d14e8f93","title":"AI-Generated Image Detection Using Semantic Feature","title_zh":"","year":2025,"publication_date":"2025-02-16","abstract":"In recent years, the rapid advancement of deep learning has brought generative models to the forefront of technological innovation, enabling the creation of highly realistic images from simple text inputs. However, this progress has also introduced new challenges in distinguishing real from synthetic content, a concern particularly evident in the misuse of such technologies for malicious purposes. This paper investigates the generalization capabilities of the CLIP Vision Transformer (ViT) model for fake image detection, leveraging its semantic understanding of images. We employ a cross-validation approach using the GenImage dataset to evaluate the performance of CLIP ViT against traditional models like ResNet-50 and Swin-T. Results demonstrate that CLIP ViT exhibits superior generalization ability on unseen datasets, outperforming other models by focusing on high-level semantic features rather than dataset-specific patterns. This study highlights the potential of CLIP ViT in advancing the detection of generative model outputs by capturing underlying semantic relationships, suggesting a paradigm shift towards more robust and generalized detection techniques.","authors":[{"id":"author-db54181298c0ff","name":"Hau-Ching Chen","orcid":"","institution_ids":[]},{"id":"author-c1ffcc3c96455b","name":"Yu-Pin Shen","orcid":"","institution_ids":[]},{"id":"author-10d69c1db24614","name":"Yi-Hung Yeh","orcid":"","institution_ids":[]},{"id":"author-ca53d611937c46","name":"Jiann-Liang Chen","orcid":"","institution_ids":[]}],"institution_ids":["i154864474","institution:72e33b377a422ec3"],"venue":{"id":"venue-8b363192cb6d8e","name":"2025 27th International Conference on Advanced Communications Technology (ICACT)","short_name":"","type":"conference","issn":"","rankings":[]},"task_tags":["synthetic_detection"],"contribution_type":"method","review_status":"verified","doi":"10.23919/icact63878.2025.10936792","arxiv_id":"","openalex_id":"W4408954780","semantic_scholar_id":"","primary_url":"https://doi.org/10.23919/icact63878.2025.10936792","citation_count":2,"provenance":[{"source":"authorized_seed","source_id":"","url":"https://openalex.org/W4408954780","query":"","retrieved_at":"2026-07-15T00:00:00Z"},{"source":"openalex","source_id":"W4408954780","url":"https://openalex.org/W4408954780","query":"AI generated image detection","retrieved_at":"2026-07-15T06:11:49Z"},{"source":"crossref","source_id":"10.23919/icact63878.2025.10936792","url":"https://doi.org/10.23919/icact63878.2025.10936792","query":"AI generated image detection","retrieved_at":"2026-07-15T18:29:28Z"},{"source":"semantic_scholar","source_id":"286455172424365daaf7ec0414916badaccfe7c7","url":"https://www.semanticscholar.org/paper/286455172424365daaf7ec0414916badaccfe7c7","query":"fake image detection generative AI","retrieved_at":"2026-07-15T18:32:35Z"}],"notes":"快速批量核验：已有稳定来源，且现有任务标签与图像取证范围一致。"},{"id":"paper-1081a7b117d12c93","title":"CAMME: Adaptive Deepfake Image Detection with Multi-Modal Cross-Attention","title_zh":"","year":2025,"publication_date":"","abstract":"The proliferation of sophisticated AI-generated deepfakes poses critical challenges for digital media authentication and societal security. While existing detection methods perform well within specific generative domains, they exhibit significant performance degradation when applied to manipulations produced by unseen architectures--a fundamental limitation as generative technologies rapidly evolve. We propose CAMME (Cross-Attention Multi-Modal Embeddings), a framework that dynamically integrates visual, textual, and frequency-domain features through a multi-head cross-attention mechanism to establish robust cross-domain generalization. Extensive experiments demonstrate CAMME's superiority over state-of-the-art methods, yielding improvements of 12.56% on natural scenes and 13.25% on facial deepfakes. The framework demonstrates exceptional resilience, maintaining (over 91%) accuracy under natural image perturbations and achieving 89.01% and 96.14% accuracy against PGD and FGSM adversarial attacks, respectively. Our findings validate that integrating complementary modalities through cross-attention enables more effective decision boundary realignment for reliable deepfake detection across heterogeneous generative architectures.","authors":[{"id":"2358196150","name":"Naseem Khan","orcid":"","institution_ids":[]},{"id":"2358045869","name":"T. Nguyen","orcid":"","institution_ids":[]},{"id":"2259390428","name":"Amine Bermak","orcid":"","institution_ids":[]},{"id":"2315109933","name":"Issa M. Khalil","orcid":"","institution_ids":[]}],"institution_ids":[],"venue":{"id":"venue-886c3c4a4b4e64","name":"arXiv.org","short_name":"","type":"unknown","issn":"","rankings":[]},"task_tags":["deepfake_detection"],"contribution_type":"method","review_status":"verified","doi":"10.48550/arxiv.2505.18035","arxiv_id":"2505.18035","openalex_id":"","semantic_scholar_id":"35776b60a48d8f37c4146b97183b66158b078d5b","primary_url":"https://www.semanticscholar.org/paper/35776b60a48d8f37c4146b97183b66158b078d5b","citation_count":6,"provenance":[{"source":"semantic_scholar","source_id":"35776b60a48d8f37c4146b97183b66158b078d5b","url":"https://www.semanticscholar.org/paper/35776b60a48d8f37c4146b97183b66158b078d5b","query":"facial image manipulation detection","retrieved_at":"2026-07-15T18:32:50Z"},{"source":"arxiv","source_id":"2505.18035","url":"http://arxiv.org/abs/2505.18035v1","query":"deepfake image detection","retrieved_at":"2026-07-15T18:34:50Z"}],"notes":"快速批量核验：已有稳定来源，且现有任务标签与图像取证范围一致。"},{"id":"paper-1ede7a5f6de26793","title":"CLIP-Flow: A Universal Discriminator for AI-Generated Images Inspired by Anomaly Detection","title_zh":"","year":2025,"publication_date":"","abstract":"","authors":[{"id":"author-e6b3c3fbabc965","name":"Zhipeng Yuan","orcid":"0009-0004-8359-7339","institution_ids":[]},{"id":"author-65d4525c911709","name":"Kai Wang","orcid":"0000-0003-0053-3352","institution_ids":[]},{"id":"author-d7409681b4626f","name":"Weize Quan","orc