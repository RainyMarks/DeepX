ract":"","authors":[{"id":"author-c20ffe72026eaf","name":"Zhi-ming LI","orcid":"","institution_ids":[]},{"id":"author-4db0dd047be9a6","name":"Tai-yue WANG","orcid":"","institution_ids":[]}],"institution_ids":[],"venue":{"id":"venue-e83f3f3d582067","name":"DEStech Transactions on Computer Science and Engineering","short_name":"","type":"journal","issn":"2475-8841","rankings":[]},"task_tags":["digital_watermarking"],"contribution_type":"method","review_status":"verified","doi":"10.12783/dtcse/aiie2017/18183","arxiv_id":"","openalex_id":"","semantic_scholar_id":"","primary_url":"https://doi.org/10.12783/dtcse/aiie2017/18183","citation_count":0,"provenance":[{"source":"crossref","source_id":"10.12783/dtcse/aiie2017/18183","url":"https://doi.org/10.12783/dtcse/aiie2017/18183","query":"image watermark detection robustness","retrieved_at":"2026-07-16T04:06:11Z"}],"notes":"快速批量核验：具有稳定来源，且任务标签与图像取证范围一致。"},{"id":"paper-7436177fc7f79170","title":"Detection of image region copy-move forgery based on moment invariant features","title_zh":"","year":2012,"publication_date":"","abstract":"","authors":[{"id":"2139763","name":"Xiong Bing","orcid":"","institution_ids":[]}],"institution_ids":[],"venue":null,"task_tags":["image_forgery"],"contribution_type":"method","review_status":"verified","doi":"","arxiv_id":"","openalex_id":"","semantic_scholar_id":"0859079b36eecbe296d0061c6c582c1f5a6b7b30","primary_url":"https://www.semanticscholar.org/paper/0859079b36eecbe296d0061c6c582c1f5a6b7b30","citation_count":0,"provenance":[{"source":"semantic_scholar","source_id":"0859079b36eecbe296d0061c6c582c1f5a6b7b30","url":"https://www.semanticscholar.org/paper/0859079b36eecbe296d0061c6c582c1f5a6b7b30","query":"copy move image forgery detection","retrieved_at":"2026-07-15T18:33:00Z"}],"notes":"快速批量核验：已有稳定来源，且现有任务标签与图像取证范围一致。"},{"id":"paper-e54116c918fb3270","title":"Blind forensics of contrast enhancement in digital images","title_zh":"","year":2008,"publication_date":"2008-10-01","abstract":"Digital images have seen increased use in applications where their authenticity is of prime importance. This proves to be problematic due to the widespread availability of digital image editing software. As a result, there is a need for the development of reliable techniques for verifying an image's authenticity. In this paper, a blind forensic algorithm is proposed for detecting the use of global contrast enhancement operations to modify digital images. Furthermore, a separate algorithm is proposed to identify the use of histogram equalization, a commonly implemented contrast enhancement operation. Both algorithms perform detection by seeking out unique artifacts introduced into an image's histogram as a result of the particular operation examined. Additionally, results are presented showing the effectiveness of both proposed algorithms.","authors":[{"id":"a5023433042","name":"Matthew C. Stamm","orcid":"0000-0002-3986-4039","institution_ids":["i66946132"]},{"id":"a5032395820","name":"K.J. Ray Liu","orcid":"","institution_ids":["i66946132"]}],"institution_ids":["i66946132"],"venue":null,"task_tags":["image_forgery"],"contribution_type":"method","review_status":"verified","doi":"10.1109/icip.2008.4712454","arxiv_id":"","openalex_id":"W2115707751","semantic_scholar_id":"","primary_url":"https://doi.org/10.1109/icip.2008.4712454","citation_count":122,"provenance":[{"source":"openalex","source_id":"W2115707751","url":"https://openalex.org/W2115707751","query":"contrast enhancement image forensics","retrieved_at":"2026-07-16T03:56:55Z"},{"source":"crossref","source_id":"10.1109/icip.2008.4712454","url":"https://doi.org/10.1109/icip.2008.4712454","query":"contrast enhancement image forensics","retrieved_at":"2026-07-16T04:05:39Z"}],"notes":"快速批量核验：具有稳定来源，且任务标签与图像取证范围一致。"},{"id":"paper-c7d623824a509a70","title":"Steganalysis using image quality metrics","title_zh":"","year":2003,"publication_date":"2003-02-01","abstract":"We present techniques for steganalysis of images that have been potentially subjected to steganographic algorithms, both within the passive warden and active warden frameworks. Our hypothesis is that steganographic schemes leave statistical evidence that can be exploited for detection with the aid of image quality features and multivariate regression analysis. To this effect image quality metrics have been identified based on the analysis of variance (ANOVA) technique as feature sets to distinguish between cover-images and stego-images. The classifier between cover and stego-images is built using multivariate regression on the selected quality metrics and is trained based on an estimate of the original image. Simulation results with the chosen feature set and well-known watermarking and steganographic techniques indicate that our approach is able with reasonable accuracy to distinguish between cover and stego images.","authors":[{"id":"a5080377930","name":"İsmail Avcıbaş","orcid":"0000-0001-6789-2718","institution_ids":["i131835042"]},{"id":"a5006172625","name":"Nasir Memon","orcid":"0000-0002-0103-9762","institution_ids":["i57206974"]},{"id":"a5018114635","name":"Bülent Sankur","orcid":"0000-0001-5208-1533","institution_ids":["i4405392"]}],"institution_ids":["i131835042","i4405392","i57206974"],"venue":{"id":"venue-e43d509b0d4727","name":"IEEE Transactions on Image Processing","short_name":"TIP","type":"journal","issn":"","rankings":[{"system":"CAS","level":"1","category":"计算机科学","scope":"大类","is_top":true,"version":"2025","source_url":"https://www.iikx.com/sci/technology/13024.html","verified_at":"2026-08-12"},{"system":"JCR","level":"Q1","category":"Computer Science; Engineering","scope":"","is_top":false,"version":"2026","source_url":"https://www.iikx.com/sci/technology/13024.html","verified_at":"2026-08-12"}]},"task_tags":["image_steganalysis"],"contribution_type":"analysis","review_status":"verified","doi":"10.1109/tip.2002.807363","arxiv_id":"","openalex_id":"W2119199090","semantic_scholar_id":"","primary_url":"http